{
  "name": "@openai/chatkit-expo",
  "version": "1.0.0",
  "description": "React Native/Expo bindings for the ChatKit framework.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "react-native": "./dist/index.js",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.70",
    "expo": ">=49"
  },
  "dependencies": {
    "@openai/chatkit": "workspace:*",
    "eventsource-parser": "^1.1.2",
    "react-native-markdown-display": "^7.0.2",
    "date-fns": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.73.0",
    "expo-document-picker": "^12.0.2",
    "expo-file-system": "^17.0.1",
    "expo-image": "^1.10.6",
    "expo-image-picker": "^15.0.5",
    "expo-localization": "^15.0.3",
    "vitest": "^3.2.4",
    "tsup": "^8.0.0",
    "rimraf": "^5.0.0",
    "@testing-library/react-native": "^12.4.3",
    "jest": "^29.7.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react --external react-native --external expo-document-picker --external expo-file-system --external expo-image --external expo-image-picker --external expo-localization",
    "test": "jest",
    "types": "tsc",
    "lint": "eslint .",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openai/chatkit-js"
  },
  "license": "MIT"
}
